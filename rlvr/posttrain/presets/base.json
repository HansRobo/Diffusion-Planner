{
  "name": "base",
  "extends": "site.json",
  "objective": "awr",
  "launch": {
    "nproc": 8,
    "torchrun": ["--standalone"]
  },
  "train": {
    "use_policy_state": true,
    "resume_optimizer_state": true,
    "device": "cuda",
    "seed": 3407,
    "epochs": 60,
    "compile_mode": "default",
    "replay_sampling": "with_replacement",
    "awr_beta": 1,
    "positive_advantage_only": true,
    "positive_advantage_margin": 0.01,
    "behavior_anchor_weight": 0,
    "unsafe_behavior_anchor_weight": 0,
    "expert_anchor_weight": 0.4,
    "expert_anchor_active_groups_only": false,
    "expert_anchor_safe_step_scoped": true,
    "expert_anchor_loss_horizon": 1,
    "awr_candidate_loss_horizon": 40,
    "drop_all_zero_groups": true,
    "awr_loss_type": "plain_mse",
    "diffusion_t_range": [0.001, 0.2],
    "trainable_scope": "output",
    "learning_rate": 0.000001,
    "ema_decay": 0.95,
    "ema_per_epoch": true,
    "ema_commit_live_policy": true,
    "max_train_scenes": 0,
    "max_valid_scenes": 0,
    "eval_k": 1,
    "eval_sample_steps": 10,
    "train_selector_scenes": 65536,
    "full_valid_interval": 0,
    "hard_valid_scenes": 0,
    "scene_batch_size": 192,
    "gradient_accumulation_scenes": 192,
    "scene_load_workers": 4,
    "eval_scene_load_workers": 1,
    "eval_scene_batch_size": 512,
    "save_rollouts": 0,
    "skip_filtered_scenes": false,
    "wandb": false
  }
}
